<configuration>
    <springProperty scope="context" name="service" source="spring.application.name" defaultValue="unknown"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","level":"%level","service":"${service}","trace_id":"%X{trace_id:-}","span_id":"%X{span_id:-}","user_id":"%X{user_id:-}","order_id":"%X{order_id:-}","event_id":"%X{event_id:-}","idempotency_key":"%X{idempotency_key:-}","outbox_id":"%X{outbox_id:-}","error_code":"%X{error_code:-}","logger":"%logger{36}","message":"%replace(%msg){'"','\\"'}"}%n</pattern>
        </encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
