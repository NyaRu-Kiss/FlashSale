FROM maven:3.9.9-eclipse-temurin-21 AS build
ARG MODULE
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -pl "${MODULE}" -am -DskipTests -Dspring-boot.repackage.skip=true install \
    && mvn -B -pl "${MODULE}" -DskipTests package

FROM eclipse-temurin:21-jre
ARG MODULE
COPY --from=apache/skywalking-java-agent:9.4.0-java21 /skywalking/agent /opt/skywalking/agent
RUN cp /opt/skywalking/agent/optional-plugins/apm-spring-cloud-gateway-4.x-plugin-*.jar /opt/skywalking/agent/plugins/ \
    && cp /opt/skywalking/agent/optional-plugins/apm-spring-webflux-6.x-plugin-*.jar /opt/skywalking/agent/plugins/
COPY --from=build /workspace/${MODULE}/target/${MODULE}-0.1.0-SNAPSHOT.jar /app/app.jar
COPY config/application-acceptance.yml /app/config/application-acceptance.yml
ENTRYPOINT ["java", "-javaagent:/opt/skywalking/agent/skywalking-agent.jar", "-jar", "/app/app.jar"]
